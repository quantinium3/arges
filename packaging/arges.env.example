# Installed as /etc/arges/arges.env and loaded by systemd via EnvironmentFile;
# the binary reads these from the process environment and does not parse .env.
ARGES_APP_SOCKET=/run/arges/arges.sock
ARGES_DB_PATH=/var/lib/arges/arges.db

# Path to the 32-byte AES-256 master key that wraps every secure_string
# parameter. Required: the agent refuses to start without it, and it must not
# be readable by group or others.
#
# Leave this commented out when running under the shipped systemd unit - that
# unit delivers the key as a TPM-sealed credential and sets this variable
# itself. Uncomment it only if you opted out of credentials and keep a plain
# key file, in which case create it with:
#   head -c 32 /dev/urandom > /var/lib/arges/master.key
#   chmod 600 /var/lib/arges/master.key
# and back it up - losing it means losing every stored secret.
#ARGES_MASTER_KEY_PATH=/var/lib/arges/master.key

# The systemd unit arges reads for /api/agent/logs/history. Only change this if
# you installed the unit under a different name.
#ARGES_JOURNAL_UNIT=arges.service

# journald when running under systemd, text otherwise. Override with
# journald, json or text.
#ARGES_LOG_FORMAT=journald
#RUST_LOG=arges=info,tower_http=info
