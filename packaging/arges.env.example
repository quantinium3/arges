# Installed as /etc/arges/arges.env and loaded by systemd via EnvironmentFile;
# the binary reads these from the process environment and does not parse .env.
ARGES_APP_SOCKET=/run/arges/arges.sock
ARGES_DATABASE_URL=sqlite:///var/lib/arges/arges.db
ARGES_MASTER_KEY_PATH=/etc/arges/master_key

# journald when running under systemd, text otherwise. Override with
# journald, json or text.
#ARGES_LOG_FORMAT=journald
#RUST_LOG=arges=info,tower_http=info
